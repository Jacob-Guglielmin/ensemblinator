{
    "name": "webui-src",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": false,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "packageManager": "npm@11.5.1",
    "dependencies": {
        "@angular/common": "^22.2.1",
        "@angular/compiler": "^22.2.1",
        "@angular/core": "^22.2.1",
        "@angular/forms": "^22.2.1",
        "@angular/platform-browser": "^22.2.1",
        "@angular/router": "^22.2.1",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^22.2.1",
        "@angular/cli": "^22.2.1",
        "@angular/compiler-cli": "^22.2.1",
        "@tailwindcss/postcss": "^4.1.12",
        "postcss": "^8.5.3",
        "tailwindcss": "^4.1.12",
        "typescript": "~6.0.3"
    },
    "allowScripts": {
        "msgpackr-extract@3.0.4": true,
        "@parcel/watcher@2.6.0": true,
        "esbuild@0.28.2": true,
        "lmdb@3.5.6": true
    }
}